# docker compose 용 환경변수 — 복사해서 .env 로 만들고 값 채우기
POSTGRES_USER=todayhouse
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433   # 호스트 포트 (맥 로컬 Postgres 와 충돌 방지). 컨테이너 안은 5432
POSTGRES_DB=todayhouse
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
BACKEND_PORT=5001
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3001

# Grafana 알림 (Discord 채널 설정 → 연동 → 웹후크)
DISCORD_WEBHOOK_URL=

# 홈서버(PM2)에서 Promtail 이 읽을 PM2 로그 경로. 로컬(Docker)에선 비워둬도 됨
PM2_LOG_DIR=
